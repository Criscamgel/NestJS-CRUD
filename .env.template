MONGODB=
# Orígenes CORS (lista separada por comas). Si vacío, se permiten cheky.co + localhost:5173.
# Incluye la URL exacta del front (protocolo + dominio, sin barra final).
# CORS_ORIGINS=https://cheky.co,https://www.cheky.co,https://app.cheky.co
#
# WebApp (SPA) — enlaces en correos: bienvenida + recuperar contraseña (/auth/reset-password).
# Recomendado en producción:
# PUBLIC_WEB_APP_URL=https://app.cheky.co
#
# Si defines FRONTEND_URL, debe ser la SPA (mismo host que arriba), no solo la landing.
# FRONTEND_URL=https://app.cheky.co
#
# Landing (Vite) — URL absoluta sin barra final. El API la usa para armar el retorno de Bold (ej. ?pagoBold=1).
# Si falta, el checkout público responde 400.
# PUBLIC_LANDING_URL=https://cheky.co
#
# Legacy: si solo existe FRONTEND_PATH apuntando a https://cheky.co, el API reescribe a app.cheky.co en enlaces de mail.
# FRONTEND_PATH=https://cheky.co
FRONTEND_PATH=
PUBLIC_LANDING_URL=
PUBLIC_WEB_APP_URL=
FRONTEND_URL=
#
# Planes: moneda por plan (USD, COP, EUR, …) — catálogo en plan-currencies.catalog.ts.
# Bold recibe amount.currency del plan al crear el link de pago (multimoneda según tu cuenta Bold).
#
# Bold — API Link (pagos en línea). Sin esto el checkout público responde 400.
# El API en producción lee principalmente BOLD_API_LINK_URL (igual que el demo):
# https://github.com/Jorge-Ivan/mini-demo-store-with-bold-payments/blob/main/nest-shop/.env.example
# Documentación: https://developers.bold.co/pagos-en-linea/api-integration
#
# Host base sin barra final (se llama POST/GET …/online/link/v1 según docs Bold).
# BOLD_API_LINK_URL=https://integrations.api.bold.co
BOLD_API_LINK_URL=
# Opcional: mismo valor que arriba si algún entorno aún usa el nombre legacy.
# BOLD_API_LINK_URI=https://integrations.api.bold.co
BOLD_API_LINK_URI=
# Llave de identidad / API Key (cabecera x-api-key al llamar Bold).
BOLD_API_KEY=
# Llave secreta para el hash de integridad del botón / link de pago (no exponer en el front).
BOLD_SECRET_KEY=
JWT_SECRET=
PORT=3002
DEFAULT_LIMIT=10
# RiskSeal — POST a credit-scoring/v2 (cuerpo: first_name, last_name, email, phone E.164; no enviar id).
# URL completa o solo el host; si falta el path, el API añade /credit-scoring/v2
# REQUEST_RISKSEAL=https://pentastar.riskseal.io/credit-scoring/v2
# KEY_RISKSEAL=
REQUEST_RISKSEAL=
KEY_RISKSEAL=
# Nodemailer setup
MAILER_HOST=
MAILER_PORT=
MAILER_EMAIL=
MAILER_SECRET_KEY=
#
# Bold Pagos (enlaces de pago + webhook). Ver integración tipo:
# https://github.com/Jorge-Ivan/mini-demo-store-with-bold-payments
# BOLD_SECRET_KEY=
# BOLD_API_KEY=
# (Opcional) Ya con path completo: https://integrations.api.bold.co/online/link/v1
# URL absoluta de la landing para callback (?pagoBold=1)
# PUBLIC_LANDING_URL=https://cheky.co
# DEBUG_BOLD_WEBHOOK=true

# Cloudflare Turnstile (Secret solo en API; Site Key en VITE_TURNSTILE_SITE_KEY en frontends)
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# ─── Commercial Appointments ───────────────────────────────
APPOINTMENT_DEFAULT_TIMEZONE=America/Bogota
APPOINTMENT_INBOX=ventas@cheky.co
APPOINTMENT_START_HOUR=08:00
APPOINTMENT_END_HOUR=18:00
APPOINTMENT_SLOT_DURATION=15
APPOINTMENT_MAX_ADVANCE_DAYS=30
APPOINTMENT_MEETING_LINK_BASE=https://meet.jit.si/cheky-reunion-